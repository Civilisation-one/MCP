# Never put real secrets in this file.

# Read-only public data access (civ1_fetch_public_data). Off unless set to 1.
CIV1_PUBLIC_DATA_ENABLED=0
# Extra endpoints for source "allowlisted_json": comma-separated host/path/prefix/ entries.
# Public hostnames only; IP literals, localhost, .local and .internal are rejected.
CIV1_PUBLIC_DATA_ALLOWLIST=
